# ─────────────────────────────────────────────────────────────────────────────
# DataVault contracts — environment template
# Copy to contracts/.env (gitignored) and fill in. NEVER commit real secrets.
#   cp contracts/.env.example contracts/.env
# ─────────────────────────────────────────────────────────────────────────────

# Local Hardhat node (started with `npm run node`, or the docker-compose
# `hardhat` service). Used by --network localhost.
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# Optional: private key of the DEPLOYER/coordinator account.
# Required only for deploying to Polygon Amoy. For the local Hardhat node the
# pre-funded deterministic account #0 is used automatically (no key needed).
# NEVER expose this key to the frontend or commit it to git.
# Example (Hardhat account #0, local only, DO NOT USE ON MAINNET):
# PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
PRIVATE_KEY=

# Optional: public Polygon testnet (Amoy) — never required for the demo.
# Get a free RPC URL from Alchemy/Infura/PublicNode and test MATIC from a faucet.
POLYGON_AMOY_RPC_URL=
POLYGON_AMOY_CHAIN_ID=80002

# Address of an already-deployed DataVaultRewards contract.
# If empty, `npm run seed:local` deploys a fresh one and prints the address.
REWARD_CONTRACT_ADDRESS=
