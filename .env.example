# ─────────────────────────────────────────────────────────────────────────────
# DataVault — environment template
#
#   cp .env.example .env
#
# Then adapt values as needed. NEVER commit real secrets: .env is gitignored
# (add `.env` to your .gitignore) and private keys must never reach the
# frontend or the git history.
#
# DataVault is a research / hackathon demonstration (spec §2, §55): default
# values below are demo-safe and deliberately weak.
# ─────────────────────────────────────────────────────────────────────────────

# ── backend (FastAPI services/api · docker-compose) ─────────────────────────
# PostgreSQL connection used by the api service container.
DATABASE_URL=postgresql://datavault:datavault@postgres:5432/datavault

# Redis connection (queues, pub-sub, live events).
REDIS_URL=redis://redis:6379

# JWT signing secret for the api service. Generate a strong one for anything
# beyond a local demo, e.g.:  openssl rand -hex 32
JWT_SECRET=datavault-dev-secret-change-me-please-32b

# Internal URL the api service uses to reach the ml-service container.
ML_SERVICE_URL=http://ml-service:8001

# ── blockchain (api service ↔ DataVaultRewards contract) ────────────────────
# JSON-RPC endpoint of the DataVault local test network (hardhat container).
# For Polygon Amoy use your Alchemy/Infura/PublicNode testnet URL instead.
BLOCKCHAIN_RPC_URL=http://hardhat:8545

# Chain id: 31337 = local Hardhat network. Polygon Amoy = 80002.
CHAIN_ID=31337

# Private key of the api service's blockchain coordinator account.
# · LOCAL DEMO  : leave empty — the api service uses Hardhat account #0
#                 (0xf39F…2266, publicly known dev key, local chain only).
# · AMOY TESTNET: a burner key funded with test MATIC. NEVER a mainnet key.
#                 NEVER expose this to the frontend or commit it to git.
BLOCKCHAIN_PRIVATE_KEY=

# Address of the deployed DataVaultRewards contract. Leave empty and the api
# service deploys it automatically at startup (recommended for the demo).
# To pin: docker compose exec hardhat npx hardhat run scripts/deploy.js
#         --network localhost   → copy the printed address here.
REWARD_CONTRACT_ADDRESS=

# ── web (Next.js 16) ────────────────────────────────────────────────────────
# "" (default) = EMBEDDED DEMO ENGINE ("sandbox mode"): the web app serves the
#   Next.js API routes with the TS federated-learning engine, local hash-chain
#   ledger and SQLite demo data — fully self-contained demo.
# Set to the FastAPI base URL (e.g. http://localhost:8000) to switch the web
#   app to the FastAPI backend. NEXT_PUBLIC_* vars are inlined at BUILD time →
#   run `docker compose up --build --force-recreate web` after changing.
NEXT_PUBLIC_API_URL=

# Privacy mode of the embedded engine: DEMO (fast, deterministic, masked
# updates) or ENCRYPTION (adds real AES-256-GCM authenticated encryption of
# masked updates). Production additionally uses TenSEAL CKKS in ml-service.
PRIVACY_MODE=DEMO

# ── optional tuning ─────────────────────────────────────────────────────────
# ml-service mode: demo | encryption
#ML_MODE=demo
# Log level for the Python services
#LOG_LEVEL=info
